# Public hostname of the MCP endpoint. Its DNS A record must point at this VPS (Caddy gets the certificate).
AUTOWP_DOMAIN=mcp.example.com

# Bearer tokens as id:<sha256 hex>, comma separated. Create one with:
#   docker compose run --rm auto-wp --gen-token laptop
# Only the hash goes here; the token itself goes into Claude Code on your computer.
AUTOWP_MCP_TOKENS=

# 1 = image with Chromium for screenshot comparisons (larger), 0 = HTTP-only health checks.
AUTOWP_PLAYWRIGHT_IMAGE=1

# AUTOWP_LOG_LEVEL=info
# AUTOWP_HTTP_PORT=80
# AUTOWP_HTTPS_PORT=443
