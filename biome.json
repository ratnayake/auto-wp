{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.vitepress/cache",
      "!**/.vitepress/dist",
      "!**/.tmp",
      "!agent-php/vendor",
      "!pnpm-lock.yaml",
      "!docs/index.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": { "enabled": true, "rules": { "preset": "none" } }
}
